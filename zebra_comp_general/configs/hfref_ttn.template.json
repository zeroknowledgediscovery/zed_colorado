{
  "analysis_name": "hfref_ttn",
  "results_root": "../RESULTS",
  "canonical_id": "patient_id",
  "inputs": {
    "genomics": {"path": "PATH_TO_GENOMIC_MATRIX.csv", "id_column": "patient_id"},
    "phenotypes": {"path": "PATH_TO_HFREF_PHENOTYPES.csv", "id_column": "patient_id"},
    "zebra": {"path": "PATH_TO_HFREF_ZEBRA.parquet", "id_column": "patient_id", "score_column": "predicted_risk", "duplicate_policy": "identical"}
  },
  "phenotypes": [
    {"name": "HFrEF", "column": "HFREF_LABEL", "positive_values": ["Y", 1, "1"], "negative_values": ["N", 0, "0"], "missing": "negative"}
  ],
  "primary_phenotype": "HFrEF",
  "score_range": [0, 1],
  "genomic_features": {
    "type": "file",
    "path": "../HFREF_genomic_header_matches.csv",
    "column_field": "header_name"
  },
  "gene_signal": {
    "enabled": true,
    "name": "TTN_pathogenic_carrier",
    "type": "binary_column",
    "column": "TTN_pathogenic_carrier"
  },
  "analysis": {
    "operating_fprs": [0.005, 0.01, 0.02, 0.05, 0.10],
    "control_fpr_bands": [[0.02, 0.05], [0.05, 0.10], [0.10, 0.20], [0.20, 0.40]],
    "local_window_half_width_percentile": 5.0,
    "tail_percentiles": [95, 97.5, 99],
    "lr_deltas": [0.10, 0.05, 0.025, 0.01, 0.005],
    "rescue_fpr_pairs": [[0.005, 0.02], [0.005, 0.05], [0.005, 0.10], [0.01, 0.02], [0.01, 0.05], [0.01, 0.10]]
  }
}
