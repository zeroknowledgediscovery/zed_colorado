\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Boundary-targeted \textit  {MUC5B} rescue compared with a fair ZeBRA-only rule matched on training-set operational FPR. Sensitivity and FPR differences are rescue minus matched ZeBRA. The adjudicated-negative comparison uses the same untouched outer-test subjects and the already training-derived matched threshold. Values are means across 100 repeated outer splits; the final column gives the fraction of splits in which rescue produced a lower adjudicated-negative FPR than matched ZeBRA.}}{9}{table.5}\protected@file@percent }
\newlabel{tab:boundary-selected}{{V}{9}{Boundary-targeted \textit {MUC5B} rescue compared with a fair ZeBRA-only rule matched on training-set operational FPR. Sensitivity and FPR differences are rescue minus matched ZeBRA. The adjudicated-negative comparison uses the same untouched outer-test subjects and the already training-derived matched threshold. Values are means across 100 repeated outer splits; the final column gives the fraction of splits in which rescue produced a lower adjudicated-negative FPR than matched ZeBRA}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Direct empirical likelihood-ratio support for stochastic boundary localization.} (a) Median high-probability residual-genomic bounds across nine prespecified estimator specifications, with error bars spanning the minimum to maximum. The 95\% and 99\% bounds are stable, whereas the 99.5\% tail is more estimator-sensitive. (b) In the primary estimator, median clinical log-likelihood evidence rises sharply across the upper ZeBRA tail while the 95th percentile of the residual genomic scale remains substantially smaller. (c) The fraction of subjects for whom clinical evidence exceeds the estimated residual genomic scale approaches one in the extreme tail; points show the median across specifications and error bars span the full sensitivity range. (d) Genomic-induced decision changes remain concentrated near the clinical likelihood-ratio boundary across stringent operating points.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:empirical-lr-robustness}{{4}{10}{\textbf {Direct empirical likelihood-ratio support for stochastic boundary localization.} (a) Median high-probability residual-genomic bounds across nine prespecified estimator specifications, with error bars spanning the minimum to maximum. The 95\% and 99\% bounds are stable, whereas the 99.5\% tail is more estimator-sensitive. (b) In the primary estimator, median clinical log-likelihood evidence rises sharply across the upper ZeBRA tail while the 95th percentile of the residual genomic scale remains substantially smaller. (c) The fraction of subjects for whom clinical evidence exceeds the estimated residual genomic scale approaches one in the extreme tail; points show the median across specifications and error bars span the full sensitivity range. (d) Genomic-induced decision changes remain concentrated near the clinical likelihood-ratio boundary across stringent operating points}{figure.4}{}}
