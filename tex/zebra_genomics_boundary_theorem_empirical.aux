\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Global discrimination and incremental genomic value.} (a) Mean held-out AUC with one standard deviation across repeated outer splits; small horizontal offsets separate the three model estimates at each endpoint. (b) Paired AUC difference between the nonlinear combined model and ZeBRA for each endpoint; negative values favor ZeBRA. (c) Paired AUC change after adding the genomic panel to a regularized ZeBRA model evaluated on the same held-out subjects. (d) Mean paired changes in average precision (AP), Brier score, and log loss for the primary FILD/FILA endpoint. For AP, negative values indicate deterioration; for Brier score and log loss, positive values indicate deterioration. The FILD/FILA endpoint is primary; the two nonfibrotic endpoints are sparse ancillary comparisons.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:global-evidence}{{1}{7}{\textbf {Global discrimination and incremental genomic value.} (a) Mean held-out AUC with one standard deviation across repeated outer splits; small horizontal offsets separate the three model estimates at each endpoint. (b) Paired AUC difference between the nonlinear combined model and ZeBRA for each endpoint; negative values favor ZeBRA. (c) Paired AUC change after adding the genomic panel to a regularized ZeBRA model evaluated on the same held-out subjects. (d) Mean paired changes in average precision (AP), Brier score, and log loss for the primary FILD/FILA endpoint. For AP, negative values indicate deterioration; for Brier score and log loss, positive values indicate deterioration. The FILD/FILA endpoint is primary; the two nonfibrotic endpoints are sparse ancillary comparisons}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {ZeBRA and \textit  {MUC5B} represent distinct predictive channels.} (a) ZeBRA predicts T-carrier status at approximately chance level in the pooled sample and within disease strata. (b) T-carrier prevalence is substantially higher among FILD/FILA-positive subjects than among explicitly adjudicated-negative subjects. (c) The apparent carrier enrichment in the extreme pooled ZeBRA tail disappears after stratification by disease status; the dashed line denotes no enrichment. Together, these results argue against implicit genotype reconstruction as the explanation for ZeBRA's predictive performance.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:muc5b-apparent-stratified}{{2}{7}{\textbf {ZeBRA and \textit {MUC5B} represent distinct predictive channels.} (a) ZeBRA predicts T-carrier status at approximately chance level in the pooled sample and within disease strata. (b) T-carrier prevalence is substantially higher among FILD/FILA-positive subjects than among explicitly adjudicated-negative subjects. (c) The apparent carrier enrichment in the extreme pooled ZeBRA tail disappears after stratification by disease status; the dashed line denotes no enrichment. Together, these results argue against implicit genotype reconstruction as the explanation for ZeBRA's predictive performance}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-F}}Direct empirical likelihood-ratio analysis supports the stochastic theorem}{8}{subsection.7.6}\protected@file@percent }
