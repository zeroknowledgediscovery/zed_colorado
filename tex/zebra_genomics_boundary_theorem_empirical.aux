\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Decision-level consequences of localized genomic utility and clinical-tail dominance.} (a) Held-out sensitivity gain for boundary-targeted \textit  {MUC5B} rescue relative to a ZeBRA-only threshold matched on training-set false-positive rate. (b) The corresponding difference in realized operational false-positive rate remains near zero. (c) Among explicitly adjudicated negatives, rescue-minus-matched-ZeBRA false-positive-rate differences are negative on average for five of the six evaluated rules; error bars show split-wise 2.5th--97.5th percentile ranges. (d) Fraction of outer splits in which rescue has lower adjudicated-negative FPR than its fair matched-ZeBRA comparator; the dashed line marks 0.5. Circles denote an upper target FPR of 0.5\% and squares 1\% in panels (a)--(d). (e) At stringent requested false-positive rates, ZeBRA achieves substantially larger held-out LR$+$ than the genomic-only model. (f) Corresponding held-out sensitivity.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:decision-consequences}{{5}{11}{\textbf {Decision-level consequences of localized genomic utility and clinical-tail dominance.} (a) Held-out sensitivity gain for boundary-targeted \textit {MUC5B} rescue relative to a ZeBRA-only threshold matched on training-set false-positive rate. (b) The corresponding difference in realized operational false-positive rate remains near zero. (c) Among explicitly adjudicated negatives, rescue-minus-matched-ZeBRA false-positive-rate differences are negative on average for five of the six evaluated rules; error bars show split-wise 2.5th--97.5th percentile ranges. (d) Fraction of outer splits in which rescue has lower adjudicated-negative FPR than its fair matched-ZeBRA comparator; the dashed line marks 0.5. Circles denote an upper target FPR of 0.5\% and squares 1\% in panels (a)--(d). (e) At stringent requested false-positive rates, ZeBRA achieves substantially larger held-out LR$+$ than the genomic-only model. (f) Corresponding held-out sensitivity}{figure.5}{}}
